{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "build:mac": {
      "dependsOn": ["build"],
      "outputs": ["release/**"]
    }
  }
}
