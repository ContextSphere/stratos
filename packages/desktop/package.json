{
  "name": "@stratosapp/desktop",
  "version": "0.2.0",
  "private": true,
  "productName": "Stratos",
  "description": "Stratos — Open Source AI Agent Desktop",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContextSphere/stratos.git"
  },
  "bugs": {
    "url": "https://github.com/ContextSphere/stratos/issues"
  },
  "homepage": "https://github.com/ContextSphere/stratos#readme",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:fullscreen": "FULLSCREEN=1 electron-vite dev",
    "dev:debug": "ENABLE_CDP=1 electron-vite dev",
    "build": "electron-vite build",
    "build:deps": "pnpm -w --filter @stratosapp/core --filter @stratosapp/ui build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mac": "pnpm build:deps && electron-vite build && electron-builder --mac",
    "build:mac:dir": "pnpm build:deps && electron-vite build && electron-builder --mac --dir",
    "postinstall": "bash scripts/patch-electron-name.sh && chmod +x ../../node_modules/.pnpm/node-pty@*/node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex-sdk": "0.111.0",
    "@stratosapp/core": "workspace:*",
    "@stratosapp/gateway": "workspace:*",
    "@stratosapp/ui": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-cron": "^4.2.1",
    "node-pty": "^1.1.0",
    "ollama": "^0.6.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.4",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.4",
    "chrome-devtools-mcp": "^0.17.0",
    "electron": "^40.9.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
