{
  "name": "@agentpanel/desktop",
  "version": "0.0.1",
  "productName": "AgentPanel",
  "description": "AgentPanel — Open Source AI Agent Desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "ENABLE_CDP=1 electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mac": "electron-vite build && electron-builder --mac",
    "postinstall": "bash scripts/patch-electron-name.sh"
  },
  "dependencies": {
    "@agentpanel/core": "workspace:*",
    "@agentpanel/ui": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.2.66",
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex-sdk": "0.111.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.4",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.4",
    "chrome-devtools-mcp": "^0.17.0",
    "electron": "^40.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.6.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
