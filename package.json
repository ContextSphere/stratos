{
  "name": "stratos",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=@stratosapp/core --filter=@stratosapp/ui --filter=@stratosapp/desktop",
    "dev:fullscreen": "turbo dev:fullscreen --filter=@stratosapp/desktop",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "build:mac": "turbo build:mac --filter=@stratosapp/desktop",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "tar": "^7.5.11",
      "flatted": "^3.4.2",
      "dompurify": "^3.4.0",
      "@xmldom/xmldom": "^0.8.12",
      "picomatch@2": "^2.3.2",
      "picomatch@3": "^3.0.2",
      "picomatch@4": "^4.0.4",
      "brace-expansion@1": "^1.1.13",
      "brace-expansion@2": "^2.0.3",
      "brace-expansion@3": "^3.0.2",
      "brace-expansion@5": "^5.0.5",
      "vite@7": "^7.3.2",
      "protobufjs": ">=7.5.5",
      "form-data": "^4.0.5",
      "fast-uri": "^3.1.2",
      "hono": "^4.12.18",
      "ip-address": "^10.1.1",
      "qs": "^6.14.1",
      "tough-cookie": "^4.1.3",
      "@anthropic-ai/sdk": "^0.91.1",
      "postcss": "^8.5.10",
      "request": "npm:@cypress/request@^3.0.10",
      "yaml": "^2.8.3",
      "uuid@11": "^11.1.1"
    }
  },
  "volta": {
    "node": "20.20.2",
    "pnpm": "9.15.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
