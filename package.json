{
  "name": "stratos",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=@stratosapp/core --filter=@stratosapp/ui --filter=@stratosapp/desktop",
    "dev:fullscreen": "turbo dev:fullscreen --filter=@stratosapp/desktop",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "build:mac": "turbo build:mac --filter=@stratosapp/desktop",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "tar": "^7.5.11",
      "flatted": "^3.4.2",
      "dompurify": "^3.4.0",
      "@xmldom/xmldom": "^0.8.12",
      "picomatch@4": "^4.0.4",
      "brace-expansion@5": "^5.0.5",
      "vite@7": "^7.3.2"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
